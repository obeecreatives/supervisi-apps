# ==============================================================================
# ENVIRONMENT VARIABLES UNTUK DEPLOYMENT VERCEL / PRODUCTION
# ==============================================================================

# 1. URL Domain Aplikasi Anda (Opsional, diisi URL produksi Vercel Anda)
VITE_APP_URL="https://gas-modernization-hub.vercel.app"

# 2. Versi Node.js di Vercel (Opsional, Vercel default otomatis Node 20.x / 22.x)
NODE_VERSION="20.x"

# 3. Gemini API Key (Opsional, hanya jika mengaktifkan backend AI assistant di server)
# GEMINI_API_KEY="AIzaSy..."

